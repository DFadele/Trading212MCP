# Copy to untracked .env.http for Compose. Inject managed secrets on a cloud host.
TRADING212_API_KEY=
TRADING212_API_SECRET=
TRADING212_ENVIRONMENT=demo
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_AUTH_MODE=oauth
# Replace these with actual registered OAuth resource/IdP values (no placeholders work).
MCP_PUBLIC_URL=
MCP_OAUTH_ISSUER=
MCP_OAUTH_JWKS_URL=
MCP_OAUTH_SUBJECT=
MCP_OAUTH_SCOPE=portfolio:read
# Additional exact platform health-check hostnames, only when needed. No wildcards.
MCP_ALLOWED_HOSTS=[]
MCP_ALLOWED_ORIGINS=["http://localhost:6274","http://127.0.0.1:6274"]
MCP_SHUTDOWN_SECONDS=30
MARKET_PROVIDER=yfinance
MARKET_FUNDAMENTALS_SOURCE=sec
MARKET_SEC_USER_AGENT=
MARKET_RESOLUTION_CACHE_PATH=/data/instrument-mappings.sqlite3
# Optional public market cache; omit to keep market data memory-only.
# MARKET_CACHE_PATH=/data/market-cache.sqlite3
MARKET_CACHE_TTL_SECONDS=3600
MARKET_CACHE_MAX_ENTRIES=512
MARKET_RISK_TIMEOUT_SECONDS=50
MARKET_FETCH_CONCURRENCY=4
MARKET_SCREEN_MAX_CANDIDATES=40
