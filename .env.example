TRADING212_API_KEY=
TRADING212_API_SECRET=
TRADING212_ENVIRONMENT=demo

# Optional licensed alternative; not needed for the default Yahoo/SEC providers.
MARKET_FMP_API_KEY=
MARKET_REQUESTS_PER_MINUTE=60
MARKET_CACHE_TTL_SECONDS=3600
MARKET_CACHE_MAX_ENTRIES=512
MARKET_TIMEOUT_SECONDS=20
# Overall portfolio/candidate/optimisation FETCH budget; align with client timeout.
# Optimisation can additionally use up to 20 seconds of solver work.
MARKET_RISK_TIMEOUT_SECONDS=50
MARKET_RETRIES=2
MARKET_MIN_OBSERVATIONS=60
MARKET_SCREEN_MAX_CANDIDATES=40
# Explicit listing selection; ISIN/currency are still validated.
MARKET_INSTRUMENT_OVERRIDES={}

# Personal experiment defaults: Yahoo prices/discovery + SEC annual US statements.
MARKET_PROVIDER=yfinance
# sec = SEC annual block; provider = native vendor block; fmp = licensed FMP block.
MARKET_FUNDAMENTALS_SOURCE=sec
# SEC requires a real contact email; only needed in sec mode.
MARKET_SEC_USER_AGENT=

# Yahoo is installed with the standard project dependencies.
MARKET_YAHOO_REGIONS=["us"]
# Optional operator-verified provider-symbol -> ISIN mapping; no fuzzy matching.
MARKET_YAHOO_ISIN_MAP={}

# Automatic identifier lookup; public OpenFIGI API works without a key.
MARKET_OPENFIGI_ENABLED=true
MARKET_OPENFIGI_API_KEY=
# Public identifier metadata and remembered choices only; mount this on persistent
# storage in a container. No portfolio amounts or credentials are stored here.
MARKET_RESOLUTION_CACHE_PATH=.cache/instrument-mappings.sqlite3
MARKET_RESOLUTION_CACHE_TTL_DAYS=30

# Overlap independent risk holdings/Yahoo requests while retaining rate limits (1–8).
MARKET_FETCH_CONCURRENCY=4

# Transport defaults to stdio; HTTP requires authenticated environment configuration.
MCP_TRANSPORT=stdio
# Optional public-only market cache. SQLite + versioned JSON, never portfolio results.
# MARKET_CACHE_PATH=.cache/market-cache.sqlite3
